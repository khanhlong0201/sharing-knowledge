/* ---------- render ---------- */
function agentBlock(a) {
  return '<div class="agent" data-row data-text="' + (a.slug + ' ' + a.own + ' ' + a.meta).toLowerCase().replace(/"/g, '') + '">' +
    '<div class="slug">' + a.slug + '</div>' +
    '<p class="own">' + a.own + '</p>' +
    '<p class="meta">' + a.meta + '</p></div>';
}

document.getElementById('phases').innerHTML = PHASES.map(function (p) {
  return '<div class="phase" data-block>' +
    '<div class="phase-id"><span class="num">' + p.num + '</span><h3>' + p.name + '</h3><p>' + p.desc + '</p></div>' +
    '<div>' + p.agents.map(agentBlock).join('') + '</div></div>';
}).join('');

document.getElementById('support').innerHTML =
  '<div class="group" data-block><h3>' + SUPPORT.title + '</h3><p class="note">' + SUPPORT.desc + '</p>' +
  '<div class="grid">' + SUPPORT.agents.map(function (a) {
    return '<div class="skill plain" data-row data-text="' + (a.slug + ' ' + a.own + ' ' + a.meta).toLowerCase().replace(/"/g, '') + '">' +
      '<div class="slug">' + a.slug + '</div><p>' + a.own + '</p></div>';
  }).join('') + '</div></div>';

document.getElementById('groups').innerHTML = GROUPS.map(function (g) {
  var cells = g.items.map(function (it) {
    return '<div class="skill' + (g.star ? ' star' : '') + '" data-row data-text="' +
      (it[0] + ' ' + it[1]).toLowerCase().replace(/"/g, '').replace(/&amp;/g, '&') + '">' +
      '<div class="slug">' + it[0] + '</div><p>' + it[1] + '</p></div>';
  }).join('');
  return '<div class="group" data-block><h3>' + g.name + ' <em>' + g.items.length + '</em></h3>' +
    (g.note ? '<p class="note">' + g.note + '</p>' : '') +
    '<div class="grid">' + cells + '</div></div>';
}).join('');

/* ---------- filter ---------- */
var rows = Array.prototype.slice.call(document.querySelectorAll('[data-row]'));
var blocks = Array.prototype.slice.call(document.querySelectorAll('[data-block]'));
var hits = document.getElementById('hits');
var empty = document.getElementById('empty');
var q = document.getElementById('q');

function apply() {
  var term = q.value.trim().toLowerCase();
  var shown = 0;
  rows.forEach(function (r) {
    var ok = !term || r.getAttribute('data-text').indexOf(term) !== -1;
    r.hidden = !ok;
    if (ok) shown++;
  });
  blocks.forEach(function (b) {
    var any = b.querySelector('[data-row]:not([hidden])');
    b.hidden = !any;
  });
  hits.textContent = term ? shown + ' / ' + rows.length + ' khớp' : rows.length + ' mục';
  empty.hidden = shown !== 0;
}
q.addEventListener('input', apply);
apply();
</script>
</body>
</html>
