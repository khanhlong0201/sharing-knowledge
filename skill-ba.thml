<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bộ đồ nghề BA</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Serif:wght@500;600&display=swap">
<style>
  :root {
    --ground: #f1f2ef;
    --surface: #fbfbf9;
    --surface-2: #e9ebe6;
    --ink: #181c1a;
    --ink-2: #3c433f;
    --muted: #6e7570;
    --line: #d8dcd5;
    --line-strong: #b9bfb6;
    --accent: #0f6b5c;
    --accent-soft: #dcebe6;
    --signal: #a8511d;
    --serif: "IBM Plex Serif", Georgia, "Times New Roman", serif;
    --sans: "IBM Plex Sans", "Segoe UI", system-ui, -apple-system, sans-serif;
    --mono: "IBM Plex Mono", ui-monospace, "Cascadia Mono", Consolas, monospace;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ground: #0e1110;
      --surface: #161a19;
      --surface-2: #1d2221;
      --ink: #e7eae6;
      --ink-2: #c2c9c4;
      --muted: #8d958f;
      --line: #272d2b;
      --line-strong: #3a423f;
      --accent: #56c4ac;
      --accent-soft: #14312b;
      --signal: #dc9257;
    }
  }
  :root[data-theme="dark"] {
    --ground: #0e1110;
    --surface: #161a19;
    --surface-2: #1d2221;
    --ink: #e7eae6;
    --ink-2: #c2c9c4;
    --muted: #8d958f;
    --line: #272d2b;
    --line-strong: #3a423f;
    --accent: #56c4ac;
    --accent-soft: #14312b;
    --signal: #dc9257;
  }

  body {
    background: var(--ground);
    color: var(--ink);
    font-family: var(--sans);
    font-size: 15px;
    line-height: 1.55;
    -webkit-font-smoothing: antialiased;
  }
  .wrap {
    max-width: 1080px;
    margin: 0 auto;
    padding-inline: 20px;
    padding-block: 0 72px;
  }

  /* ---------- masthead ---------- */
  .masthead { padding-block: 44px 26px; }
  .eyebrow {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0 0 14px;
  }
  .masthead h1 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: clamp(38px, 7vw, 62px);
    line-height: 1.02;
    letter-spacing: -0.02em;
    margin: 0 0 14px;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: 62ch;
    color: var(--ink-2);
    font-size: 16px;
  }
  .lede b { color: var(--ink); font-weight: 600; }

  .tally {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin-top: 28px;
    border-top: 2px solid var(--line-strong);
    border-bottom: 1px solid var(--line);
  }
  .tally div {
    flex: 1 1 130px;
    padding: 14px 18px 14px 0;
  }
  .tally b {
    display: block;
    font-family: var(--mono);
    font-weight: 500;
    font-size: 30px;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }
  .tally span {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* ---------- toolbar ---------- */
  .toolbar {
    position: sticky;
    top: env(safe-area-inset-top, 0px);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    padding-block: 12px;
    background: color-mix(in srgb, var(--ground) 92%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--line);
  }
  #q {
    flex: 1 1 220px;
    min-width: 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--ink);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 9px 12px;
  }
  #q::placeholder { color: var(--muted); }
  #q:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
  .hits {
    font-family: var(--mono);
    font-size: 12px;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .jump { display: flex; gap: 6px; flex-wrap: wrap; }
  .jump a {
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-decoration: none;
    color: var(--ink-2);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    padding: 6px 10px;
  }
  .jump a:hover { border-color: var(--accent); color: var(--accent); }

  /* ---------- sections ---------- */
  section { padding-top: 54px; scroll-margin-top: 70px; }
  .sechead { margin-bottom: 8px; }
  .sechead h2 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 27px;
    letter-spacing: -0.015em;
    margin: 0;
  }
  .sechead p { margin: 6px 0 0; color: var(--muted); max-width: 60ch; font-size: 14px; }

  /* ---------- phases ---------- */
  .phase {
    display: grid;
    grid-template-columns: 178px minmax(0, 1fr);
    gap: 22px;
    padding-block: 26px;
    border-top: 1px solid var(--line);
  }
  .phase:first-of-type { border-top: 2px solid var(--line-strong); margin-top: 22px; }
  .phase-id { position: relative; }
  .phase-id .num {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 13px;
    letter-spacing: 0.1em;
    color: var(--signal);
    display: block;
    margin-bottom: 4px;
  }
  .phase-id h3 {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 19px;
    margin: 0 0 6px;
    letter-spacing: -0.01em;
  }
  .phase-id p { margin: 0; font-size: 13px; color: var(--muted); }

  .agent {
    padding: 0 0 16px;
    margin-bottom: 16px;
    border-bottom: 1px dotted var(--line-strong);
  }
  .agent:last-child { border-bottom: 0; margin-bottom: 0; padding-bottom: 0; }
  .agent .slug {
    font-family: var(--mono);
    font-weight: 500;
    font-size: 14px;
    color: var(--accent);
    word-break: break-word;
  }
  .agent .own { margin: 4px 0 0; color: var(--ink-2); font-size: 14px; }
  .agent .meta {
    margin: 6px 0 0;
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  /* ---------- skills ---------- */
  .group { padding-block: 24px; border-top: 1px solid var(--line); }
  .group:first-of-type { border-top: 2px solid var(--line-strong); margin-top: 22px; }
  .group > h3 {
    font-family: var(--sans);
    font-weight: 600;
    font-size: 15px;
    margin: 0 0 2px;
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .group > h3 em {
    font-family: var(--mono);
    font-style: normal;
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--muted);
    font-variant-numeric: tabular-nums;
  }
  .group > .note { margin: 0 0 14px; font-size: 13px; color: var(--muted); }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(255px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .skill {
    background: var(--surface);
    padding: 12px 14px;
  }
  .skill .slug {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    color: var(--ink);
    word-break: break-word;
  }
  .skill .slug::before { content: "/"; color: var(--accent); }
  .skill.plain .slug::before { content: none; }
  .skill.plain .slug { color: var(--accent); }
  .sechead p code, .group > .note code {
    font-family: var(--mono);
    font-size: 12px;
    background: var(--surface-2);
    padding: 1px 4px;
    border-radius: 2px;
  }
  .skill p { margin: 3px 0 0; font-size: 13px; color: var(--muted); line-height: 1.45; }
  .skill.star { background: var(--accent-soft); }
  .skill.star .slug { color: var(--accent); }
  .skill.star p { color: var(--ink-2); }

  /* ---------- chain + notes ---------- */
  .chain {
    margin-top: 22px;
    border: 1px solid var(--line-strong);
    background: var(--surface);
    padding: 16px 18px;
    overflow-x: auto;
  }
  .chain h4 {
    margin: 0 0 10px;
    font-family: var(--mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
  }
  .chain code {
    font-family: var(--mono);
    font-size: 12.5px;
    color: var(--ink-2);
    white-space: pre;
    display: block;
  }
  .chain code b { color: var(--signal); font-weight: 500; }

  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; margin-top: 22px; }
  .note-card {
    border-left: 3px solid var(--accent);
    padding: 2px 0 2px 14px;
  }
  .note-card.warn { border-left-color: var(--signal); }
  .note-card h4 { margin: 0 0 5px; font-size: 14px; font-weight: 600; }
  .note-card p { margin: 0; font-size: 13.5px; color: var(--ink-2); }
  .note-card code {
    font-family: var(--mono);
    font-size: 12.5px;
    background: var(--surface-2);
    padding: 1px 4px;
    border-radius: 2px;
  }

  .empty {
    padding: 34px 0;
    font-family: var(--mono);
    font-size: 13px;
    color: var(--muted);
  }
  footer {
    margin-top: 58px;
    padding-top: 16px;
    border-top: 2px solid var(--line-strong);
    font-family: var(--mono);
    font-size: 11.5px;
    letter-spacing: 0.04em;
    color: var(--muted);
    display: flex;
    flex-wrap: wrap;
    gap: 10px 24px;
  }

  @media (max-width: 680px) {
    .phase { grid-template-columns: 1fr; gap: 14px; }
    .masthead { padding-block: 32px 20px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>
<style>
  :root { color-scheme: light dark; }
  * { box-sizing: border-box; }
  body { margin: 0; }
  img { max-width: 100%; }
  [hidden] { display: none !important; }
</style>
</head>
<body>

<div class="wrap">
  <header class="masthead">
    <p class="eyebrow">Trần Ngọc Khánh Long · Business Analyst · Gtel OTS</p>
    <h1>Bộ đồ nghề BA</h1>
    <p class="lede">Toàn bộ <b>agent</b> và <b>skill</b> đang gắn vào vault Ideaverse và Claude Code — xếp theo đúng thứ tự chúng được gọi trong vòng đời một feature, từ khơi gợi yêu cầu tới nghiệm thu.</p>
    <div class="tally">
      <div><b>20</b><span>Agent</span></div>
      <div><b>83</b><span>Skill</span></div>
      <div><b>11</b><span>Agent BA riêng</span></div>
      <div><b>5</b><span>Giai đoạn</span></div>
    </div>
  </header>

  <div class="toolbar">
    <input id="q" type="search" placeholder="Lọc theo tên hoặc việc cần làm — vd: mockup, UAT, draw.io" autocomplete="off" aria-label="Lọc agent và skill">
    <span class="hits" id="hits"></span>
    <nav class="jump">
      <a href="#agents">Agent</a>
      <a href="#skills">Skill</a>
      <a href="#notes">Vận hành</a>
    </nav>
  </div>

  <section id="agents">
    <div class="sechead">
      <h2>Agent — 5 giai đoạn bàn giao</h2>
      <p>Đánh số vì đây là chuỗi bàn giao thật: đầu ra của giai đoạn trước là đầu vào bắt buộc của giai đoạn sau.</p>
    </div>
    <div id="phases"></div>

    <div class="chain">
      <h4>Chuỗi bàn giao</h4>
      <code>elicitation → analyst → sprint-planner → <b>[PO chốt]</b> → spec-writer
   → (process-modeler ∥ mockup-designer → mockup-reviewer)
   → user-story-writer → reviewer → <b>[publish]</b> → publish-verifier → uat-planner</code>
    </div>

    <div id="support"></div>
  </section>

  <section id="skills">
    <div class="sechead">
      <h2>Skill — 83, chia 10 nhóm</h2>
      <p>Ô tô đậm là skill chạm tới hằng ngày. Gõ <code>/</code> kèm tên để gọi.</p>
    </div>
    <div id="groups"></div>
    <p class="empty" id="empty" hidden>Không khớp gì. Xoá bớt từ khoá.</p>
  </section>

  <section id="notes">
    <div class="sechead">
      <h2>Luật cứng &amp; trạng thái vận hành</h2>
      <p>Những ràng buộc agent nào cũng phải tuân, và hai chỗ đang lệch so với danh sách đầy đủ.</p>
    </div>
    <div class="notes">
      <div class="note-card">
        <h4>Feature Spec bám đủ 14 mục</h4>
        <p>Khung lấy từ <code>Template - Feature Spec (Final).md</code>. Không tự chế khung, không rút gọn vì thấy feature đơn giản.</p>
      </div>
      <div class="note-card">
        <h4>Sơ đồ dùng draw.io, không dùng Mermaid</h4>
        <p>Field Enum trạng thái ≥2 giá trị chuyển qua lại thì bắt buộc có State Diagram riêng kèm bảng Ý nghĩa / Chuyển từ / Chuyển tới.</p>
      </div>
      <div class="note-card">
        <h4>AC đủ sâu ở mọi feature</h4>
        <p>Danh sách · Tạo từng field bắt buộc · Sửa field khoá · Xoá hoặc Suspend · tối thiểu 1 AC chặn quyền và 1 AC xác nhận Audit Log. Given/When/Then mỗi vế xuống dòng riêng.</p>
      </div>
      <div class="note-card">
        <h4>Ngoài phạm vi BA</h4>
        <p>Không viết Data Model, ERD, API Contract. Kịch bản UAT trace 1-1 với mã <code>AC-xx</code>, ngôn ngữ End-User, không viết unit test.</p>
      </div>
      <div class="note-card warn">
        <h4>gstack: nạp 6 / khoảng 45 lệnh</h4>
        <p>Phiên hiện chỉ nạp <code>gstack</code> <code>browse</code> <code>spec</code> <code>investigate</code> <code>office-hours</code> và vài skill dùng chung. Các lệnh còn lại (<code>/ship</code>, <code>/qa</code>, <code>/review</code>, <code>/canary</code>, <code>/retro</code>…) gọi qua router <code>/gstack</code>.</p>
      </div>
      <div class="note-card warn">
        <h4>MCP obsidian đang mất kết nối</h4>
        <p><code>ConnectionRefused</code> — skill <code>obsidian-organizer</code> phụ thuộc server này nên chưa chạy được. Cần mở Obsidian desktop và bật lại plugin.</p>
      </div>
    </div>
  </section>

  <footer>
    <span>Vault: Ideaverse Pro Final Long.Tnk</span>
    <span>Nguồn: ba-profile.md · danh sách skill phiên 2026-09-17</span>
  </footer>
</div>

<script>
const PHASES = [
  {
    num: "GIAI ĐOẠN 01", name: "Khởi động", desc: "Bóc tài liệu thô thành thứ chốt được với stakeholder.",
    agents: [
      { slug: "ba-elicitation-analyst", own: "Project Brief, Stakeholder RACI, Glossary, Kế hoạch khơi gợi.", meta: "Read · Grep · Glob · Write · WebSearch" }
    ]
  },
  {
    num: "GIAI ĐOẠN 02", name: "Lập kế hoạch", desc: "Từ yêu cầu thành phạm vi và lịch giao hàng.",
    agents: [
      { slug: "ba-requirement-analyst", own: "Epic &amp; Feature List, Gap Analysis, ưu tiên phạm vi, câu hỏi cần PO chốt.", meta: "Đọc hồ sơ thầu, biên bản họp, tài liệu cũ, mockup" },
      { slug: "ba-sprint-planner", own: "Release Plan chia sprint, capacity bằng số thật, phương án B, và phần KHÔNG làm.", meta: "Mỗi sprint một outcome demo được" }
    ]
  },
  {
    num: "GIAI ĐOẠN 03", name: "Thực thi", desc: "Viết spec, vẽ luồng, phác giao diện, tách story.",
    agents: [
      { slug: "ba-feature-spec-writer", own: "Feature Spec 14 mục, BR/FR/AC, Traceability Matrix.", meta: "Chạy check_spec.py trước khi báo xong" },
      { slug: "ba-process-modeler", own: "Process Flow, State Diagram, ma trận Trạng thái × Hành động.", meta: "Trả .drawio sửa được kèm ảnh xuất" },
      { slug: "ba-ui-mockup-designer", own: "Mockup HTML một file chạy được, prompt Figma/Visily.", meta: "Dùng lại component của ba-mockup-kit" },
      { slug: "ba-mockup-reviewer", own: "Soát mockup ↔ spec hai chiều, đủ 4 trạng thái, nút theo quyền.", meta: "Đọc mockup bằng grep · không tự sửa file" },
      { slug: "ba-user-story-writer", own: "Tách Feature thành User Story Jira, sub-task [BA], thứ tự backlog theo phụ thuộc.", meta: "Không tạo sub-task QC — QC có luồng riêng" }
    ]
  },
  {
    num: "GIAI ĐOẠN 04", name: "Nghiệm thu", desc: "Cổng soát trước publish, rồi kiểm lại sau publish.",
    agents: [
      { slug: "ba-reviewer", own: "Gate soát tài liệu chữ trước publish — 5 checklist theo loại tài liệu.", meta: "Chỉ liệt kê phát hiện kèm mức độ, không tự sửa" },
      { slug: "ba-publish-verifier", own: "Kiểm sau publish: đúng space và trang cha, link hai chiều, sub-task [BA] đủ chưa.", meta: "CHỈ ĐỌC — không bao giờ ghi lên Confluence/Jira" },
      { slug: "ba-uat-planner", own: "UAT Plan, kịch bản kiểm thử chấp nhận, ma trận nghiệm thu và sign-off.", meta: "Mỗi kịch bản trace 1-1 với một mã AC" }
    ]
  },
  {
    num: "GIAI ĐOẠN 05", name: "Vận hành", desc: "Sau golive: đo, đánh giá, phân loại thay đổi.",
    agents: [
      { slug: "ba-requirement-analyst", own: "Quay lại lần hai: đánh giá sau golive, phân loại Change Request, cập nhật metrics/OKR.", meta: "Luật A sửa nhanh trong sprint · Luật B phải lập tài liệu CR" }
    ]
  }
];

const SUPPORT = {
  title: "Đội phụ trợ — 9 agent không thuộc luồng BA",
  desc: "Gọi khi cần tìm code, sửa nhỏ, soát diff, hoặc quét rộng nhiều file.",
  agents: [
    { slug: "cavecrew-investigator", own: "Định vị code chỉ-đọc, trả bảng file:line. Từ chối đề xuất fix.", meta: "Output nén, main context đỡ tốn ~60%" },
    { slug: "cavecrew-builder", own: "Sửa gọn 1–2 file: typo, đổi tên máy móc, viết lại một hàm.", meta: "Từ chối cứng khi phạm vi ≥3 file" },
    { slug: "cavecrew-reviewer", own: "Soát diff/branch/file, mỗi phát hiện một dòng có gắn mức độ.", meta: "Không khen, không mở rộng phạm vi" },
    { slug: "Explore", own: "Quét rộng nhiều thư mục và quy ước đặt tên, chỉ trả kết luận.", meta: "Read-only · chỉ định độ rộng medium hay very thorough" },
    { slug: "Plan", own: "Dựng kế hoạch triển khai từng bước, chỉ ra file trọng yếu.", meta: "Read-only" },
    { slug: "general-purpose", own: "Việc nhiều bước, tìm kiếm khi chưa chắc khớp ngay lần đầu.", meta: "Toàn quyền tool" },
    { slug: "claude", own: "Catch-all cho việc không khớp agent chuyên biệt nào.", meta: "Mặc định của FleetView" },
    { slug: "claude-code-guide", own: "Trả lời về Claude Code, Agent SDK, Claude API, plugin eval.", meta: "Hỏi trước khi spawn cái mới — tái dùng agent đang chạy" },
    { slug: "statusline-setup", own: "Cấu hình status line của Claude Code.", meta: "Read · Edit" }
  ]
};

